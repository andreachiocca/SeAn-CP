! Postprocess one solved harmonic coefficient; IC is 1/2/3.
! Writes one row per critical-volume element. Use separate files for stress
! and strain so *VWRITE stays under the MAPDL 128-character line limit.
! Stress order: XX YY ZZ XY YZ XZ, MPa.
! EPEL shear from MAPDL is ENGINEERING shear, converted to tensorial in Python.
FINISH
/POST1
SET,IC
RSYS,0
ALLSEL,ALL
ETABLE,ERAS
ETABLE,SX,S,X
ETABLE,SY,S,Y
ETABLE,SZ,S,Z
ETABLE,SXY,S,XY
ETABLE,SYZ,S,YZ
ETABLE,SXZ,S,XZ
ETABLE,EX,EPEL,X
ETABLE,EY,EPEL,Y
ETABLE,EZ,EPEL,Z
ETABLE,EXY,EPEL,XY
ETABLE,EYZ,EPEL,YZ
ETABLE,EXZ,EPEL,XZ
*GET,NE,ELEM,0,COUNT
*CFOPEN,fe_stress,csv,,APPEND
*DO,IE,1,NE
 *GET,XC,ELEM,IE,CENT,X
 *GET,YC,ELEM,IE,CENT,Y
 *GET,ZC,ELEM,IE,CENT,Z
 *IF,ABS(XC),LE,GAUGE,THEN
  *IF,ABS(YC),LE,GAUGE,THEN
   *IF,ABS(ZC),LE,GAUGE,THEN
    *GET,V1,ELEM,IE,ETAB,SX
    *GET,V2,ELEM,IE,ETAB,SY
    *GET,V3,ELEM,IE,ETAB,SZ
    *GET,V4,ELEM,IE,ETAB,SXY
    *GET,V5,ELEM,IE,ETAB,SYZ
    *GET,V6,ELEM,IE,ETAB,SXZ
    *VWRITE,IC,IE,V1,V2,V3,V4,V5,V6
(8(E13.5,:,','))
   *ENDIF
  *ENDIF
 *ENDIF
*ENDDO
*CFCLOS
*CFOPEN,fe_strain,csv,,APPEND
*DO,IE,1,NE
 *GET,XC,ELEM,IE,CENT,X
 *GET,YC,ELEM,IE,CENT,Y
 *GET,ZC,ELEM,IE,CENT,Z
 *IF,ABS(XC),LE,GAUGE,THEN
  *IF,ABS(YC),LE,GAUGE,THEN
   *IF,ABS(ZC),LE,GAUGE,THEN
    *GET,V1,ELEM,IE,ETAB,EX
    *GET,V2,ELEM,IE,ETAB,EY
    *GET,V3,ELEM,IE,ETAB,EZ
    *GET,V4,ELEM,IE,ETAB,EXY
    *GET,V5,ELEM,IE,ETAB,EYZ
    *GET,V6,ELEM,IE,ETAB,EXZ
    *VWRITE,IC,IE,V1,V2,V3,V4,V5,V6
(8(E13.5,:,','))
   *ENDIF
  *ENDIF
 *ENDIF
*ENDDO
*CFCLOS
*CFOPEN,fe_coordinates,csv,,APPEND
*DO,IE,1,NE
 *GET,XC,ELEM,IE,CENT,X
 *GET,YC,ELEM,IE,CENT,Y
 *GET,ZC,ELEM,IE,CENT,Z
 *IF,ABS(XC),LE,GAUGE,THEN
  *IF,ABS(YC),LE,GAUGE,THEN
   *IF,ABS(ZC),LE,GAUGE,THEN
    *VWRITE,IC,IE,XC,YC,ZC
(5(E15.7,:,','))
   *ENDIF
  *ENDIF
 *ENDIF
*ENDDO
*CFCLOS
FINISH
