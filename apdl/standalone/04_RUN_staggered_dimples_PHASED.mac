! EXPERIMENTAL GEOMETRY B: STAGGERED TWO-DIMPLE TUBE
! Alternative to the single external notch: TWO UNEQUAL exterior spherical
! dimples at 90 degrees around circumference, staggered 6 mm in axial Z.
! Pressure-tight, unpenetrated bore (no through-hole).
! Units mm, N, MPa, N mm, linear elastic small strain, quasi-static.
! 3 solves: BASIS_MODE=1 -> unit pressure / force / torque influence fields;
!           BASIS_MODE=0 -> prescribed Fourier coefficients (mean,sin,cos).
! Self-contained input; tested with structural/static source checks only.
! This geometry HAS NOT been executed in MAPDL. Confirm mesh and bore loads.
FINISH
/CLEAR,START
/FILNAME,stagger_phased
/PREP7
RI=6.0
RO=7.5
LENGTH=48.0
NOTCH1_R=1.45
NOTCH1_D=0.50
NOTCH1_Z=-3.0
NOTCH2_R=1.75
NOTCH2_D=0.65
NOTCH2_Z=3.0
NOTCH_ON=1
MESH_H=0.50
! Two notch centres: (RO+R1-D1,0,Z1) and (0,RO+R2-D2,Z2).
! Minimum radial ligament: 1.0 mm at A, 0.85 mm at B.
! The larger notch B is intentionally staggered and rotated 90 degrees.
E_MOD=210000
POISS=0.30
! 1: unit pressure (1 MPa), force (1000 N), torque (1000 N mm).
! 0: physically constrained harmonic mean/sine/cosine, from notch_loads.mac.
BASIS_MODE=0
! Reset all export files before running (do not append to old jobs).
*CFOPEN,fe_stress,csv
*CFCLOS
*CFOPEN,fe_strain,csv
*CFCLOS
*CFOPEN,fe_coordinates,csv
*CFCLOS
*CFOPEN,fe_result_checks,csv
*CFCLOS
! 1=closed ends and pressure thrust acts through wall, 0=compensated by rig.
CLOSED_END=1
*IF,RI,LE,0,THEN
 /COM,ERROR: RI must be positive.
 /EXIT,NOSAVE
*ENDIF
*IF,RO,LE,RI,THEN
 /COM,ERROR: RO must exceed RI.
 /EXIT,NOSAVE
*ENDIF
*IF,NOTCH1_D,LE,0,THEN
 /COM,ERROR: NOTCH1_D must be positive
 /EXIT,NOSAVE
*ENDIF
*IF,NOTCH2_D,LE,0,THEN
 /COM,ERROR: NOTCH2_D must be positive
 /EXIT,NOSAVE
*ENDIF
*IF,NOTCH1_D,GE,RO-RI,THEN
 /COM,ERROR: notch 1 breaks the wall
 /EXIT,NOSAVE
*ENDIF
*IF,NOTCH2_D,GE,RO-RI,THEN
 /COM,ERROR: notch 2 breaks the wall
 /EXIT,NOSAVE
*ENDIF
*IF,NOTCH1_D,GE,NOTCH1_R,THEN
 /COM,ERROR: notch 1 depth exceeds cutter radius
 /EXIT,NOSAVE
*ENDIF
*IF,NOTCH2_D,GE,NOTCH2_R,THEN
 /COM,ERROR: notch 2 depth exceeds cutter radius
 /EXIT,NOSAVE
*ENDIF
*IF,ABS(NOTCH1_Z)+NOTCH1_R,GE,LENGTH/2,THEN
 /COM,ERROR: notch 1 too close to end
 /EXIT,NOSAVE
*ENDIF
*IF,ABS(NOTCH2_Z)+NOTCH2_R,GE,LENGTH/2,THEN
 /COM,ERROR: notch 2 too close to end
 /EXIT,NOSAVE
*ENDIF
*DIM,CTRL,ARRAY,3,3
*IF,BASIS_MODE,EQ,1,THEN
 ! Unit influence loads (pressure, axial force, torque).
 ! Three SEPARATE response solves, not harmonic coefficients.
 ! BASIS 1: 1 MPa bore pressure; BASIS 2: 1000 N axial machine force;
 ! BASIS 3: 1000 N mm applied torque. Pressure thrust automatically included.
 CTRL(1,1)=1
 CTRL(2,2)=1000
 CTRL(3,3)=1000
*ELSE
 ! Optional manually defined harmonic load coefficients.
 ! DISTINCT TRIAL: all single-harmonic, unequal phases (not optimised).
 ! p=18+12*sin(wt+45 deg) MPa => 6..30 MPa, always positive.
 ! F=500+5000*sin(wt) N => -4500..5500 N.
 ! T=1500+26000*sin(wt+90 deg) Nmm => -24500..27500 Nmm.
 ! Columns pressure(MPa), force(N), torque(Nmm); rows mean/sine/cosine.
 CTRL(1,1)=18
 CTRL(2,1)=8.48528137423857
 CTRL(3,1)=8.48528137423857
 CTRL(1,2)=500
 CTRL(2,2)=5000
 CTRL(3,2)=0
 CTRL(1,3)=1500
 CTRL(2,3)=0
 CTRL(3,3)=26000
*ENDIF
ET,1,187
MP,EX,1,E_MOD
MP,PRXY,1,POISS
TYPE,1
MAT,1
! Generate one pressure-tight annular cylinder, axis global Z.
WPCSYS,-1,0
WPOFFS,0,0,-LENGTH/2
CYL4,0,0,RI,0,RO,360,LENGTH
*GET,TUBEID,VOLU,0,NUM,MAX
*IF,NOTCH_ON,EQ,1,THEN
 ! Notch A: shallow spherical exterior dimple at +X, Z=-3 mm.
 WPCSYS,-1,0
 CENTER1=RO+NOTCH1_R-NOTCH1_D
 WPOFFS,CENTER1,0,NOTCH1_Z
 SPHERE,0,NOTCH1_R
 *GET,TOOLID,VOLU,0,NUM,MAX
 VSBV,TUBEID,TOOLID
 ALLSEL,ALL
 *GET,NVOL,VOLU,0,COUNT
 *IF,NVOL,NE,1,THEN
  /COM,ERROR: first Boolean must leave exactly one tube volume
  /EXIT,NOSAVE
 *ENDIF
 *GET,TUBEID,VOLU,0,NUM,MAX
 ! Notch B: DIFFERENT radius/depth at +Y, Z=+3 mm.
 WPCSYS,-1,0
 CENTER2=RO+NOTCH2_R-NOTCH2_D
 WPOFFS,0,CENTER2,NOTCH2_Z
 SPHERE,0,NOTCH2_R
 *GET,TOOLID,VOLU,0,NUM,MAX
 VSBV,TUBEID,TOOLID
*ENDIF
ALLSEL,ALL
*GET,NVOL,VOLU,0,COUNT
*IF,NVOL,NE,1,THEN
 /COM,ERROR: expected one connected, pressure-tight tube solid
 /EXIT,NOSAVE
*ENDIF
! Reset WP and construct full 3D unstructured quadratic tetrahedral mesh.
WPCSYS,-1,0
CSYS,0
MSHKEY,0
MSHAPE,1,3
ESIZE,MESH_H
VMESH,ALL
ALLSEL,ALL
*GET,NE,ELEM,0,COUNT
*IF,NE,LT,1,THEN
 /COM,ERROR: mesh empty.
 /EXIT,NOSAVE
*ENDIF
! Store TWO distinct notch neighbourhoods with subsurface elements.
! Components are defined once; identical element IDs are exported per basis.
ALLSEL,ALL
ESEL,S,CENT,X,RI+0.05,RO+0.25
ESEL,R,CENT,Y,-2.6,2.6
ESEL,R,CENT,Z,NOTCH1_Z-2.4,NOTCH1_Z+2.4
*GET,NA,ELEM,0,COUNT
*IF,NA,LT,1,THEN
 /COM,ERROR: no elements near notch A
 /EXIT,NOSAVE
*ENDIF
CM,GAUGEA,ELEM
ALLSEL,ALL
ESEL,S,CENT,Y,RI+0.05,RO+0.25
ESEL,R,CENT,X,-2.8,2.8
ESEL,R,CENT,Z,NOTCH2_Z-2.6,NOTCH2_Z+2.6
*GET,NB,ELEM,0,COUNT
*IF,NB,LT,1,THEN
 /COM,ERROR: no elements near notch B
 /EXIT,NOSAVE
*ENDIF
CM,GAUGEB,ELEM
CMSEL,S,GAUGEA
CMSEL,A,GAUGEB
CM,GAUGEBOTH,ELEM
*GET,NG,ELEM,0,COUNT
*CFOPEN,fe_gauge_summary,csv
*VWRITE,NA,NB,NG
(3(E18.10,:,','))
*CFCLOS
ALLSEL,ALL
! Rigid grips idealised with bottom annular end fixed in all translation.
! This is a SCREENING model: actual grips, shoulder fillets and seal are absent.
EPSLOC=0.02
NSEL,S,LOC,Z,-LENGTH/2-EPSLOC,-LENGTH/2+EPSLOC
*GET,NBASE,NODE,0,COUNT
*IF,NBASE,LT,1,THEN
 /COM,ERROR: bottom end nodes absent.
 /EXIT,NOSAVE
*ENDIF
D,ALL,UX,0
D,ALL,UY,0
D,ALL,UZ,0
ALLSEL,ALL
! Compute top end nodal moment denominator, for balanced tangential
! nodal loading: FX=-T*Y/SUM(R**2), FY=T*X/SUM(R**2).
NSEL,S,LOC,Z,LENGTH/2-EPSLOC,LENGTH/2+EPSLOC
*GET,NTOP,NODE,0,COUNT
*IF,NTOP,LT,1,THEN
 /COM,ERROR: top end nodes absent.
 /EXIT,NOSAVE
*ENDIF
NR2SUM=0
NID=NDNEXT(0)
*DO,JJ,1,NTOP
 *GET,XN,NODE,NID,LOC,X
 *GET,YN,NODE,NID,LOC,Y
 NR2SUM=NR2SUM+XN*XN+YN*YN
 NID=NDNEXT(NID)
*ENDDO
ALLSEL,ALL
FINISH
/SOLU
ANTYPE,STATIC
NLGEOM,OFF
OUTRES,ALL,ALL
*DO,IC,1,3
 ALLSEL,ALL
 FDELE,ALL,ALL
 SFDELE,ALL,PRES
 PI=CTRL(IC,1)
 FA=CTRL(IC,2)
 TORQ=CTRL(IC,3)
 ! Only the internal CYLINDRICAL bore is pressurised; no pressure on the
 ! external notch. CSYS,1 gives radial coordinate in NSEL,LOC,X.
 CSYS,1
 NSEL,S,LOC,X,RI-0.01,RI+0.01
 *GET,NBOR,NODE,0,COUNT
 *IF,NBOR,LT,1,THEN
  /COM,ERROR: no internal bore nodes selected.
  /EXIT,NOSAVE
 *ENDIF
 SF,ALL,PRES,PI
 ALLSEL,ALL
 CSYS,0
 ! Pressure thrust from closed ends is added once to top axial load.
 ! Machine axial force FA is independent of this hydraulic thrust.
 FATOT=FA
 *IF,CLOSED_END,EQ,1,THEN
  FATOT=FA+PI*3.141592653589793*RI*RI
 *ENDIF
 NSEL,S,LOC,Z,LENGTH/2-EPSLOC,LENGTH/2+EPSLOC
 F,ALL,FZ,FATOT/NTOP
 NID=NDNEXT(0)
 *DO,JJ,1,NTOP
  *GET,XN,NODE,NID,LOC,X
  *GET,YN,NODE,NID,LOC,Y
  FXT=-TORQ*YN/NR2SUM
  FYT= TORQ*XN/NR2SUM
  F,NID,FX,FXT
  F,NID,FY,FYT
  NID=NDNEXT(NID)
 *ENDDO
 ALLSEL,ALL
 TIME,IC
 SOLVE

! Dual-notch critical-region tensor export; same CSV layout as Python parser.
! IC is solved basis index. Data: 1,2,3 + element ID + six comps.
! Selected regions cover the two dimple roots and subsurface material.
FINISH
/POST1
! SET,IC requests load-step IC, not the IC-th available result set.
! Solve stages can be indexed as substeps of one load step in the .rst.
! Therefore read the newest result and verify its pseudo-time explicitly.
SET,LAST
*GET,RES_TIME,ACTIVE,0,SET,TIME
*GET,RES_COUNT,ACTIVE,0,SET,NSET
*CFOPEN,fe_result_checks,csv,,APPEND
*VWRITE,IC,RES_TIME,RES_COUNT
(3(E18.10,:,','))
*CFCLOS
*IF,ABS(RES_TIME-IC),GT,0.00001,THEN
 /COM,ERROR: result set time does not match unit-load index.
 /COM,ERROR: inspect ANSYS .out/.err, do not use partial CSVs.
 /EXIT,NOSAVE
*ENDIF
RSYS,0
CSYS,0
ALLSEL,ALL
! Union of subsurface gauge clouds surrounding notch A and B.
CMSEL,S,GAUGEBOTH
*GET,NGAUGE,ELEM,0,COUNT
*IF,NGAUGE,LT,1,THEN
 /COM,ERROR: no notch-region elements selected; check GAUGE dimensions.
 /EXIT,NOSAVE
*ENDIF
ETABLE,ERAS
ETABLE,SX,S,X
ETABLE,SY,S,Y
ETABLE,SZ,S,Z
ETABLE,SXY,S,XY
ETABLE,SYZ,S,YZ
ETABLE,SXZ,S,XZ
ETABLE,EX,EPEL,X
ETABLE,EY,EPEL,Y
ETABLE,EZ,EPEL,Z
ETABLE,EXY,EPEL,XY
ETABLE,EYZ,EPEL,YZ
ETABLE,EXZ,EPEL,XZ
*CFOPEN,fe_stress,csv,,APPEND
EID=ELNEXT(0)
*DO,II,1,NGAUGE
 *GET,V1,ELEM,EID,ETAB,SX
 *GET,V2,ELEM,EID,ETAB,SY
 *GET,V3,ELEM,EID,ETAB,SZ
 *GET,V4,ELEM,EID,ETAB,SXY
 *GET,V5,ELEM,EID,ETAB,SYZ
 *GET,V6,ELEM,EID,ETAB,SXZ
 *VWRITE,IC,EID,V1,V2,V3,V4,V5,V6
(8(E18.10,:,','))
 EID=ELNEXT(EID)
*ENDDO
*CFCLOS
*CFOPEN,fe_strain,csv,,APPEND
EID=ELNEXT(0)
*DO,II,1,NGAUGE
 *GET,V1,ELEM,EID,ETAB,EX
 *GET,V2,ELEM,EID,ETAB,EY
 *GET,V3,ELEM,EID,ETAB,EZ
 *GET,V4,ELEM,EID,ETAB,EXY
 *GET,V5,ELEM,EID,ETAB,EYZ
 *GET,V6,ELEM,EID,ETAB,EXZ
 *VWRITE,IC,EID,V1,V2,V3,V4,V5,V6
(8(E18.10,:,','))
 EID=ELNEXT(EID)
*ENDDO
*CFCLOS
*CFOPEN,fe_coordinates,csv,,APPEND
EID=ELNEXT(0)
*DO,II,1,NGAUGE
 *GET,XV,ELEM,EID,CENT,X
 *GET,YV,ELEM,EID,CENT,Y
 *GET,ZV,ELEM,EID,CENT,Z
 *VWRITE,IC,EID,XV,YV,ZV
(5(E18.10,:,','))
 EID=ELNEXT(EID)
*ENDDO
*CFCLOS
ALLSEL,ALL
FINISH

 /SOLU
*ENDDO
FINISH
