! Phase 6C: planar cruciform with 2 in-plane normal and shear TRACTIONS.
! Applicable to exact case 1739 tensor (in-plane only). Concept fixture:
! normal + tangential components on opposing x/y arm ends. A standard
! four-axial cruciform (or STEP four-drive machine) lacks independent shear.
! NOT a documented clone of Hitachi 0/45/90 apparatus.
FINISH
/CLEAR,START
/FILNAME,calibration_model
/PREP7
*DIM,ST,ARRAY,3,6
ST(1,1)=1
ST(2,2)=1
ST(3,4)=1
E_MOD=210000
POISS=.30
CORE=12
ARM_W=8
ARM_L=22
THICK=2
HALF=CORE/2
HALFA=ARM_W/2
HALFT=THICK/2
ENDX=HALF+ARM_L
AREA=ARM_W*THICK
GAUGE=2
ET,1,187
MP,EX,1,E_MOD
MP,PRXY,1,POISS
BLOCK,-HALF,HALF,-HALF,HALF,-HALFT,HALFT
BLOCK,HALF,ENDX,-HALFA,HALFA,-HALFT,HALFT
BLOCK,-ENDX,-HALF,-HALFA,HALFA,-HALFT,HALFT
BLOCK,-HALFA,HALFA,HALF,ENDX,-HALFT,HALFT
BLOCK,-HALFA,HALFA,-ENDX,-HALF,-HALFT,HALFT
VGLUE,ALL
ALLSEL,ALL
MSHKEY,0
ESIZE,1.7
VMESH,ALL
A=NODE(-ENDX,-HALFA,-HALFT)
B=NODE(ENDX,-HALFA,-HALFT)
C=NODE(-HALFA,-ENDX,-HALFT)
D,A,UX,0
D,A,UY,0
D,A,UZ,0
D,B,UY,0
D,B,UZ,0
D,C,UZ,0
FINISH
/SOLU
ANTYPE,STATIC
NLGEOM,OFF
OUTRES,ALL,ALL
*DO,IC,1,3
 ALLSEL,ALL
 FDELE,ALL,ALL
 XX=ST(IC,1)
 YY=ST(IC,2)
 XY=ST(IC,4)
 *DO,ISIGN,1,2
  SG=1
  FACE=ENDX
  *IF,ISIGN,EQ,1,THEN
   SG=-1
   FACE=-ENDX
  *ENDIF
  ALLSEL,ALL
  NSEL,S,LOC,X,FACE
  *GET,NN,NODE,0,COUNT
  *IF,NN,LT,1,THEN
   /COM,ERROR: missing x end face
   /EXIT,NOSAVE
  *ENDIF
  F,ALL,FX,SG*XX*AREA/NN
  F,ALL,FY,SG*XY*AREA/NN
  ALLSEL,ALL
  NSEL,S,LOC,Y,FACE
  *GET,NN,NODE,0,COUNT
  *IF,NN,LT,1,THEN
   /COM,ERROR: missing y end face
   /EXIT,NOSAVE
  *ENDIF
  F,ALL,FY,SG*YY*AREA/NN
  F,ALL,FX,SG*XY*AREA/NN
 *ENDDO
 ALLSEL,ALL
 TIME,IC
 SOLVE
 *USE,export_critical
 /SOLU
*ENDDO
FINISH
